# 复制为 .env 后按环境填写：cp .env.example .env
# 生成 SECRET_KEY：python -c "import secrets;print(secrets.token_urlsafe(64))"

# ---- Django ----
# 本地开发改成 true（否则 /media/ 效果图不托管），生产保持 false
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-please
# 部署域名/IP，逗号分隔，不要带 scheme
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 容器内部健康检查使用的 Host；生产设为 DJANGO_ALLOWED_HOSTS 中的一个精确域名。
DJANGO_HEALTHCHECK_HOST=localhost
# 走 HTTPS 或非默认端口时必填，需带 scheme
DJANGO_CSRF_TRUSTED_ORIGINS=
# 生产域名必须使用 HTTPS；本地裸机开发可临时改为 false
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_COOKIES=true
# HSTS 先以 1 天灰度；确认所有子域均 HTTPS 后再逐步提升至 31536000。
DJANGO_SECURE_HSTS_SECONDS=86400
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_LOG_LEVEL=INFO
# Compose 使用 Redis 共享 TalkBot 限流计数；裸机单进程可改用 FileBasedCache。
DJANGO_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
DJANGO_CACHE_LOCATION=redis://cache:6379/1
# FileBasedCache / LocMemCache 兜底容量（Redis 后端忽略）。
DJANGO_CACHE_MAX_ENTRIES=50000
DJANGO_CACHE_CULL_FREQUENCY=10
# 线上链路为 TLS/CDN 边缘代理 + Compose nginx，共两个可信代理。
# 必须在防火墙限制源站端口只接受边缘代理；链路变化时同步调整。
DJANGO_NUM_PROXIES=2

# ---- 数据库（留空则回落本地 SQLite）----
POSTGRES_DB=home_design
POSTGRES_USER=home_design
POSTGRES_PASSWORD=change-me-too
# 裸机直连示例：DATABASE_URL=postgres://user:pass@127.0.0.1:5432/home_design

# ---- 静态 / 媒体 ----
# compose 内已固定为 /data/media 与 /app/staticfiles，裸机部署时按需覆盖
# DJANGO_MEDIA_ROOT=/data/media
# DJANGO_STATIC_ROOT=/app/staticfiles
# 所有媒体文件始终走 Django 会话与对象归属鉴权，不提供匿名目录直发。

# ---- 邮件 / 密码重置 ----
# 开发默认 console 后端；生产改成 SMTP，例如 QQ 邮箱：
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.qq.com
# DJANGO_EMAIL_PORT=465
# DJANGO_EMAIL_HOST_USER=you@qq.com
# DJANGO_EMAIL_HOST_PASSWORD=授权码
# DJANGO_EMAIL_USE_TLS=false
# DJANGO_EMAIL_USE_SSL=true
# DJANGO_DEFAULT_FROM_EMAIL=you@qq.com
# 重置链接有效期（分钟），默认 30
# DJANGO_PASSWORD_RESET_TIMEOUT_MINUTES=30

# ---- 短信验证码 ----
# console=本地联调（验证码打印到日志）；webhook=POST 到短信网关
SMS_BACKEND=webhook
SMS_WEBHOOK_URL=https://sms-gateway.example.com/send
# SMS_WEBHOOK_TIMEOUT=10
# SMS_CODE_LENGTH=6
# SMS_CODE_TTL_MINUTES=5
# SMS_MAX_ATTEMPTS=5

# ---- 邮箱验证码 ----
# EMAIL_CODE_LENGTH=6
# EMAIL_CODE_TTL_MINUTES=5
# EMAIL_CODE_MAX_ATTEMPTS=5

# ---- 持久登录 ----
# 客户端关闭后可用令牌恢复登录的有效天数，默认 30
# REMEMBER_TOKEN_TTL_DAYS=30

# ---- 支付 / 额度 ----
# ⚠️ 生产环境必须改为 live，mock 仅用于本地联调（不真实扣款）。
# mock=本地联调；live=真实收款。上线前切换 live 并配置 Stripe 密钥。
PAYMENT_MODE=live
# 每位用户一次性免费生成次数，默认 5
PAYMENT_FREE_CREDITS=5

# Stripe（国际信用卡）
# PAYMENT_STRIPE_SECRET_KEY=sk_live_xxx
# PAYMENT_STRIPE_PUBLIC_KEY=pk_live_xxx
# PAYMENT_STRIPE_WEBHOOK_SECRET=whsec_xxx
# PAYMENT_STRIPE_CURRENCY=hkd
# CNY 折算为 Stripe 币种的汇率，仅套餐为 CNY 且目标币种不同时使用
# PAYMENT_STRIPE_EXCHANGE_RATE=1.09
# Stripe Managed Payments 所需的产品税务代码，默认数字服务
# PAYMENT_STRIPE_TAX_CODE=txcd_10000000
# Stripe API 版本（Managed Payments 需要较新版本）
# PAYMENT_STRIPE_API_VERSION=2025-03-31.basil

# 微信支付 Native（启用时全部填写）
# PAYMENT_WECHAT_APP_ID=wx...
# PAYMENT_WECHAT_MCH_ID=1900000000
# PAYMENT_WECHAT_SERIAL_NO=...
# PAYMENT_WECHAT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----
# PAYMENT_WECHAT_API_V3_KEY=32位密钥
# PAYMENT_WECHAT_PLATFORM_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----
# PAYMENT_WECHAT_NOTIFY_URL=https://your-domain/api/payments/webhook/wechat/

# 支付宝当面付（启用时全部填写；SELLER_ID 用于回调收款账号校验）
# PAYMENT_ALIPAY_APP_ID=2021...
# PAYMENT_ALIPAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----
# PAYMENT_ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----
# PAYMENT_ALIPAY_SELLER_ID=2088...
# PAYMENT_ALIPAY_NOTIFY_URL=https://your-domain/api/payments/webhook/alipay/

# ---- 首次部署 ----
# 1 = 启动时灌入 prompt 模块 / 生图工作流 / 示例数据
SEED_ON_START=1
# 推荐首次启动后执行 `docker compose exec web python manage.py createsuperuser`。
# 如需自动创建，用户名与至少 16 位强密码必须显式填写；示例故意留空。
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# ---- 运行时 ----
HTTP_PORT=80
GUNICORN_WORKERS=3
GUNICORN_THREADS=8
# 必须大于前端 axios 超时 360s
GUNICORN_TIMEOUT=600

# ---- TalkBot / DeepSeek 文本模型 ----
# API Key 只放服务器 .env 或 Secret 管理器，严禁提交到 Git。
# 未配置 Key 时保持 false，TalkBot 会安全使用规则回复。
TALKBOT_LLM_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
# 默认低延迟模型；需要更强推理时可改为 deepseek-v4-pro。
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=25
DEEPSEEK_MAX_RETRIES=1
# TALKBOT_SESSION_RATE=10/day
# TALKBOT_MESSAGE_RATE=30/hour
# TALKBOT_CONVERT_RATE=10/day
# TALKBOT_IP_RATE=120/hour
# AUTH_REGISTER_IP_RATE=10/day
# AUTH_LOGIN_IP_RATE=60/hour
# AUTH_LOGIN_TARGET_RATE=10/hour
# AUTH_VERIFICATION_IP_RATE=30/hour
# AUTH_VERIFICATION_TARGET_RATE=5/hour
# AUTH_PASSWORD_RESET_IP_RATE=10/hour
# AUTH_PASSWORD_RESET_TARGET_RATE=5/hour
# DESIGN_RENDER_USER_RATE=12/hour
# DESIGN_RENDER_IP_RATE=30/hour
# DESIGN_SALES_USER_RATE=10/day
# DESIGN_SALES_IP_RATE=30/day

# 注意：生图服务商的 API Base / API Key / 模型名不放这里，
# 上线后在后台 /admin/design/generationconfig/ 填写并勾选「启用真实调用」。
